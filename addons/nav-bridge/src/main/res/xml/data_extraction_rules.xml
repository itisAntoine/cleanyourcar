<?xml version="1.0" encoding="utf-8"?>
<!-- The paired-client token is a local secret: never back it up or transfer it to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
